---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
	DUMP_MANIFEST,
	packageVersion,
	readPackageVersion,
	DATAPACKAGE_FILENAME,
} from '../../../scripts/compile.ts';
import { UNSTABLE_BANNER } from '../../lib/banner.ts';

// This page lists the files and links to `datapackage.json` for the exact byte
// counts and hashes. It deliberately does not repeat them.
//
// `npm run build` runs `astro build` first and `scripts/compile.ts` second, so
// the page cannot read `dist/dump/datapackage.json` — the file does not exist
// yet. Recomputing the numbers here instead meant serialising and hashing every
// dump body twice per build, ~90 MB each time, to render figures that the
// descriptor already publishes as machine-readable data. `DUMP_MANIFEST` gives
// the file list with no body at all, so the two sides still cannot disagree
// about which files exist.
const resources = DUMP_MANIFEST;
// The same normalisation the descriptor applies, so the version this page
// shows and the version `datapackage.json` carries cannot differ.
const version = packageVersion(readPackageVersion());

const DESCRIPTIONS: Record<string, string> = {
	works: 'One Work record per line: the texts that get cited.',
	'citation-systems':
		'One CitationSystem record per line: the locator grammar of a citation tradition.',
	references:
		'One CanonicalReference record per line: a single point in a work under one citation system, with its resolver targets.',
	mappings:
		'One MappingAssertion record per line: a link from a work to an identifier in another system.',
	aliases:
		'The whole alias table as one JSON object. A key is a /cite/ alias path or an external identifier IRI; a value is the canonical IRI it resolves to.',
};

const PARSE_HINTS: Record<string, string> = {
	jsonl: 'Read line by line. Each line is one JSON object.',
	json: 'Read as one JSON document.',
};
---

<StarlightPage
	frontmatter={{
		title: 'Bulk downloads',
		description:
			'Every TextRefs record in one file: newline-delimited JSON dumps, the alias table, and a Frictionless data package with a byte count and a sha256 hash per file.',
		template: 'doc',
		tableOfContents: false,
		banner: UNSTABLE_BANNER,
	}}
>
	<p>
		<code>/dump/</code> carries the whole registry, rebuilt on every deploy. Read
		it instead of crawling the record pages: one request replaces thousands. The entry
		point is{' '}
		<a href="/dump/datapackage.json">
			<code>datapackage.json</code>
		</a>, a <a href="https://datapackage.org/">Frictionless</a> descriptor that names
		every file with its byte count and its <code>sha256</code> hash. Read the sizes
		and the hashes there: this page lists the files, and the descriptor is their machine-readable
		record.
	</p>

	<p>
		These artifacts describe registry version <strong>{version}</strong>. The
		records are the same ones that <code>/id/</code> serves, without the JSON-LD{
			' '
		}<code>@context</code>. The <a href="/api/">API contract</a> documents the media
		types: the host serves a <code>.jsonl</code> body as{' '}
		<code>application/octet-stream</code>, so parse by documented shape, not by
		response header.
	</p>

	<div class="dump-table-wrap">
		<table>
			<thead>
				<tr>
					<th scope="col">File</th>
					<th scope="col">Contents</th>
				</tr>
			</thead>
			<tbody>
				{
					resources.map((resource) => (
						<tr>
							<th scope="row">
								<a href={`/dump/${resource.filename}`}>
									<code>{resource.filename}</code>
								</a>
							</th>
							<td>
								{DESCRIPTIONS[resource.name]} {PARSE_HINTS[resource.format]}
							</td>
						</tr>
					))
				}
				<tr>
					<th scope="row">
						<a href={`/dump/${DATAPACKAGE_FILENAME}`}>
							<code>{DATAPACKAGE_FILENAME}</code>
						</a>
					</th>
					<td>
						The manifest for the five files above: the byte count and the{' '}
						<code>sha256</code> hash of each, plus the registry version and the licence.
						Read as one JSON document.
					</td>
				</tr>
			</tbody>
		</table>
	</div>

	<h2>Verify a download</h2>

	<p>
		Recompute the hash, then compare it with the <code>hash</code> field that{
			' '
		}
		<a href="/dump/datapackage.json">
			<code>datapackage.json</code>
		</a> records for that file. The descriptor writes it as <code>sha256:</code> and
		the hex digest:
	</p>

	<pre><code>curl -sO https://textrefs.org/dump/references.jsonl
shasum -a 256 references.jsonl
curl -s https://textrefs.org/dump/datapackage.json | jq -r '.resources[] | select(.path == "references.jsonl") | .hash'</code></pre>

	<p>
		The six files above are registry data, and carry the{' '}
		<a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0 1.0</a>{
			' '
		}
		dedication that <code>datapackage.json</code> declares, as all TextRefs registry
		data does. This page is not one of them: the site code that renders it is licensed{
			' '
		}
		<a href="https://www.gnu.org/licenses/agpl-3.0.html">AGPL-3.0-or-later</a>.
	</p>
</StarlightPage>

<style>
	/* The contents column can still exceed the prose column on a narrow screen.
	   Scroll the table, never the page. */
	.dump-table-wrap {
		overflow-x: auto;
	}
</style>
