---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {
	loadWorks,
	loadSystems,
	loadReferences,
	loadMappings,
	uuidOf,
} from '../../../lib/registry.ts';

export async function getStaticPaths() {
	const PAGE_SIZE = 200;
	const PREVIEW = 20;
	const works = loadWorks();
	const systems = loadSystems();
	const refs = loadReferences();
	const mappings = loadMappings();
	return works.map((work) => {
		const workIri = work.id;
		const workRefs = refs
			.filter((r) => r.work_key === work.key)
			.sort((a, b) =>
				a.locator.localeCompare(b.locator, undefined, { numeric: true }),
			);
		const workMappings = mappings.filter((m) => m.subject === workIri);
		const usedSystemKeys = Array.from(
			new Set(workRefs.map((r) => r.citation_system_key)),
		);
		const usedSystems = usedSystemKeys
			.map((k) => systems.find((s) => s.key === k))
			.filter((s): s is NonNullable<typeof s> => Boolean(s));
		const pageCount = Math.max(1, Math.ceil(workRefs.length / PAGE_SIZE));
		return {
			params: { key: work.key },
			props: {
				work,
				preview: workRefs.slice(0, PREVIEW),
				refCount: workRefs.length,
				pageCount,
				pageSize: PAGE_SIZE,
				mappings: workMappings,
				systems: usedSystems,
			},
		};
	});
}

const { work, preview, refCount, pageCount, pageSize, mappings, systems } =
	Astro.props;
---

<StarlightPage
	frontmatter={{
		title: work.preferred_label,
		description: `Registry record for the work ${work.preferred_label}.`,
		template: 'doc',
		tableOfContents: false,
	}}
>
	<p class="reg-sub">
		<span class="reg-tag">Work</span>
		<span class="reg-tag">{work.status}</span>
		<code class="reg-iri">{work.id}</code>
	</p>

	<h2>Citation systems</h2>
	{
		systems.length === 0 ? (
			<p class="reg-empty">No citation systems registered for this work yet.</p>
		) : (
			<ul class="reg-list">
				{systems.map((s) => (
					<li>
						<a href={`/reg/system/${s.key}/`}>{s.preferred_label}</a>{' '}
						<code class="reg-iri">{s.key}</code>
					</li>
				))}
			</ul>
		)
	}

	<h2>Mappings ({mappings.length})</h2>
	{
		mappings.length === 0 ? (
			<p class="reg-empty">No mappings yet.</p>
		) : (
			<ul class="reg-list">
				{mappings.map((m) => (
					<li>
						<span class="reg-tag">{m.relation}</span>
						{m.target.target_kind && (
							<span class="reg-tag">{m.target.target_kind}</span>
						)}
						<a href={m.target.identifier}>{m.target.identifier}</a>
					</li>
				))}
			</ul>
		)
	}

	<h2>References ({refCount})</h2>
	{
		refCount === 0 ? (
			<p class="reg-empty">No references registered yet.</p>
		) : (
			<>
				<ul class="reg-list">
					{preview.map((r) => (
						<li>
							<a href={`/reg/id/${uuidOf(r.id)}/`}>
								<code>{r.locator}</code>
							</a>{' '}
							<span class="reg-tag">{r.resolver_targets.length} target(s)</span>
						</li>
					))}
				</ul>
				<p>
					<a href={`/reg/work/${work.key}/refs/1/`}>
						Browse all {refCount} reference(s){' '}
						{pageCount > 1 ? `(${pageCount} pages of ${pageSize})` : ''} →
					</a>
				</p>
			</>
		)
	}
</StarlightPage>
