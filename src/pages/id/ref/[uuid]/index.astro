---
import RecordPage from '../../../../layouts/RecordPage.astro';
import {
	loadAliases,
	loadReferences,
	loadWorks,
	loadSystems,
	uuidOf,
} from '../../../../lib/registry.ts';
import { toCSL, formatChicago, toCOinS } from '../../../../lib/citation.ts';
import {
	DRAFT_RECORD_COPY,
	getRecordStatusBanner,
	NO_SUCCESSOR_RECORD_COPY,
	SUPERSEDED_BY_COPY,
} from '../../../../lib/record-status.ts';

export async function getStaticPaths() {
	const refs = loadReferences();
	const works = loadWorks();
	const systems = loadSystems();
	const aliases = loadAliases();
	const worksByKey = new Map(works.map((w) => [w.key, w]));
	const systemsByKey = new Map(systems.map((s) => [s.key, s]));
	const aliasesByTarget = new Map<string, string[]>();
	for (const [key, target] of Object.entries(aliases)) {
		if (key.includes('://')) continue;
		const targetAliases = aliasesByTarget.get(target);
		if (targetAliases) targetAliases.push(key);
		else aliasesByTarget.set(target, [key]);
	}
	// Works cited under several systems repeat locator strings across them
	// (ADR-0005), so the locator alone no longer identifies the passage in the
	// page title or the rendered citation.
	const systemsByWork = new Map<string, Set<string>>();
	for (const r of refs) {
		const seen = systemsByWork.get(r.work_key);
		if (seen) seen.add(r.citation_system_key);
		else systemsByWork.set(r.work_key, new Set([r.citation_system_key]));
	}
	return refs.map((ref) => {
		const work = worksByKey.get(ref.work_key);
		const system = systemsByKey.get(ref.citation_system_key);
		const refAliases = (aliasesByTarget.get(ref.id) ?? []).slice().sort();
		const targets = ref.resolver_targets ?? [];
		const langs = Array.from(
			new Set(targets.map((t) => t.language ?? '—')),
		).sort();
		const byLang = langs.map((lang) => ({
			lang,
			items: targets.filter((t) => (t.language ?? '—') === lang),
		}));
		return {
			params: { uuid: uuidOf(ref.id) },
			props: {
				ref,
				work,
				system,
				aliases: refAliases,
				byLang,
				multiSystem: (systemsByWork.get(ref.work_key)?.size ?? 1) > 1,
			},
		};
	});
}

const { ref, work, system, aliases, byLang, multiSystem } = Astro.props;
const workLabel = work?.preferred_label ?? ref.work_key;
const systemLabel = system?.preferred_label ?? ref.citation_system_key;
const pageTitle = multiSystem
	? `${workLabel} ${ref.locator} (${systemLabel})`
	: `${workLabel} ${ref.locator}`;
const jsonHref = `/id/ref/${uuidOf(ref.id)}.json`;
const site = Astro.site ?? new URL('https://textrefs.org');
const aliasUrls = aliases.map((alias) =>
	new URL(`/cite/${alias}/`, site).toString(),
);

const csl = toCSL(work, ref, system);
const chicago = formatChicago(csl, { includeSection: multiSystem });
const coins = toCOinS(csl);
const escapeHtml = (s: string) =>
	s
		.replace(/&/g, '&amp;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;')
		.replace(/"/g, '&quot;');
const chicagoHtml = escapeHtml(chicago).replace(/\*([^*]+)\*/g, '<em>$1</em>');

const {
	isDraft,
	isTombstone,
	title: statusTitle,
} = getRecordStatusBanner(ref.status);
---

<RecordPage
	title={pageTitle}
	description={`Canonical reference ${ref.locator} in ${workLabel}, ${systemLabel}.`}
	jsonHref={jsonHref}
	noindex={isDraft}
>
	<h1>{pageTitle}</h1>
	<p class="reg-sub">
		<span class="reg-tag">CanonicalReference</span>{' '}
		<span class="reg-tag">{ref.status}</span>{' '}
		<code class="reg-iri">{ref.id}</code>{' '}
		<a href={jsonHref}>JSON</a>
	</p>

	{
		isDraft && (
			<aside class="banner banner-draft" role="note">
				<p>
					<strong>Draft record.</strong> {DRAFT_RECORD_COPY.beforeStatus}{' '}
					<code>{DRAFT_RECORD_COPY.status}</code>{' '}
					{DRAFT_RECORD_COPY.afterStatus}
				</p>
			</aside>
		)
	}
	{
		isTombstone && (
			<aside class="banner banner-tombstone" role="note">
				<p>
					<strong>{statusTitle}</strong>
				</p>
				{ref.superseded_by ? (
					<p>
						{SUPERSEDED_BY_COPY}{' '}
						<a href={ref.superseded_by}>{ref.superseded_by}</a>.
					</p>
				) : (
					<p>{NO_SUCCESSOR_RECORD_COPY}</p>
				)}
			</aside>
		)
	}

	<h2>In context</h2>
	<ul class="reg-list">
		<li>
			Work:{' '}
			{
				work ? (
					<a href={`/id/work/${work.key}/`}>{work.preferred_label}</a>
				) : (
					<code>{ref.work_key}</code>
				)
			}
		</li>
		<li>
			Citation system:{' '}
			{
				system ? (
					<a href={`/id/system/${system.key}/`}>{system.preferred_label}</a>
				) : (
					<code>{ref.citation_system_key}</code>
				)
			}
		</li>
		<li>
			Locator: <code>{ref.locator}</code>
		</li>
	</ul>

	<h2>Cite this reference</h2>
	<blockquote class="cite-text" set:html={chicagoHtml} />
	<span class="Z3988" hidden title={coins}></span>

	<h2>Aliases ({aliasUrls.length})</h2>
	{
		aliasUrls.length === 0 ? (
			<p class="reg-empty">No aliases registered for this reference.</p>
		) : (
			<ul class="reg-list">
				{aliasUrls.map((aliasUrl) => (
					<li>
						<a href={aliasUrl}>
							<code class="reg-iri">{aliasUrl}</code>
						</a>
					</li>
				))}
			</ul>
		)
	}

	<h2>Resolver targets ({ref.resolver_targets.length})</h2>
	{
		ref.resolver_targets.length === 0 ? (
			<p class="reg-empty">
				No resolver targets registered for this reference.
			</p>
		) : (
			<div>
				{byLang.map((group) => (
					<div class="reg-lang-group">
						<div class="reg-lang-label">
							Language: <code>{group.lang}</code>
						</div>
						<ul class="reg-list">
							{group.items.map((t) => (
								<li>
									<a href={t.url} target="_blank" rel="noopener noreferrer">
										{t.provider ?? t.url}
									</a>{' '}
									{t.edition && <span class="reg-tag">{t.edition}</span>}{' '}
									<span class="reg-tag">{t.access}</span>{' '}
									{t.license && <span class="reg-tag">{t.license}</span>}
									<br />
									<code class="reg-iri">{t.url}</code>
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		)
	}
</RecordPage>
