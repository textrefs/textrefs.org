---
import {
	DRAFT_RECORD_COPY,
	getRecordStatusBanner,
	NO_SUCCESSOR_RECORD_COPY,
	SUPERSEDED_BY_COPY,
} from '../lib/record-status.ts';

interface Props {
	status: string;
	supersededBy?: string;
}

const { status, supersededBy } = Astro.props;

const { isDraft, isTombstone, title } = getRecordStatusBanner(status);
---

{
	isDraft && (
		<aside class="reg-draft" role="note">
			<p class="reg-draft-title">
				<strong>Draft record.</strong>
			</p>
			<p>
				{DRAFT_RECORD_COPY.beforeStatus} <code>{DRAFT_RECORD_COPY.status}</code>{' '}
				{DRAFT_RECORD_COPY.afterStatus}
			</p>
		</aside>
	)
}

{
	isTombstone && (
		<aside class="reg-tombstone" role="note">
			<p class="reg-tombstone-title">
				<strong>{title}</strong>
			</p>
			{supersededBy ? (
				<p>
					{SUPERSEDED_BY_COPY} <a href={supersededBy}>{supersededBy}</a>.
				</p>
			) : (
				<p>{NO_SUCCESSOR_RECORD_COPY}</p>
			)}
		</aside>
	)
}

<style>
	.reg-tombstone {
		border-left: 4px solid var(--sl-color-orange, #d97706);
		background: var(--sl-color-bg-nav, rgba(217, 119, 6, 0.08));
		padding: 0.75rem 1rem;
		margin: 1rem 0;
		border-radius: 0.25rem;
	}
	.reg-tombstone-title {
		margin-top: 0;
	}
	.reg-tombstone p {
		margin: 0.25rem 0;
	}
	.reg-draft {
		border-left: 4px solid var(--sl-color-blue, #2563eb);
		background: var(--sl-color-bg-nav, rgba(37, 99, 235, 0.08));
		padding: 0.75rem 1rem;
		margin: 1rem 0;
		border-radius: 0.25rem;
	}
	.reg-draft-title {
		margin-top: 0;
	}
	.reg-draft p {
		margin: 0.25rem 0;
	}
</style>
