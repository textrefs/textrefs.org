---
interface Props {
	maturity?: string;
}

const { maturity } = Astro.props;

const COPY: Record<string, { label: string; body: string; tone: string }> = {
	'working-draft': {
		label: 'Working Draft',
		body: 'This document is an unstable working draft. The data model and this specification may change without notice and without a version bump while the core is being settled. Do not rely on it for production use yet.',
		tone: 'caution',
	},
	'candidate-recommendation': {
		label: 'Candidate Recommendation',
		body: 'This document is stable enough to implement against. Breaking changes still require a major version bump, but are not expected before the next release.',
		tone: 'note',
	},
	recommendation: {
		label: 'Recommendation',
		body: 'This document is a stable recommendation. Breaking changes require a major version bump and a new document.',
		tone: 'tip',
	},
	superseded: {
		label: 'Superseded',
		body: 'This document has been superseded by a later version. See the standard index for the current version.',
		tone: 'danger',
	},
};

const entry = maturity ? COPY[maturity] : undefined;
---

{
	entry && (
		<aside class:list={['mat-banner', `mat-banner-${entry.tone}`]} role="note">
			<p class="mat-banner-label">
				<strong>{entry.label}</strong>
			</p>
			<p>{entry.body}</p>
		</aside>
	)
}

<style>
	.mat-banner {
		border-left: 4px solid var(--sl-color-accent, #6b7280);
		background: var(--sl-color-bg-nav, rgba(107, 114, 128, 0.06));
		padding: 0.75rem 1rem;
		margin: 1rem 0;
		border-radius: 0.25rem;
	}
	.mat-banner-caution {
		border-left-color: var(--sl-color-orange, #d97706);
		background: rgba(217, 119, 6, 0.06);
	}
	.mat-banner-note {
		border-left-color: var(--sl-color-blue, #2563eb);
		background: rgba(37, 99, 235, 0.06);
	}
	.mat-banner-tip {
		border-left-color: var(--sl-color-green, #16a34a);
		background: rgba(22, 163, 74, 0.06);
	}
	.mat-banner-danger {
		border-left-color: var(--sl-color-red, #dc2626);
		background: rgba(220, 38, 38, 0.06);
	}
	.mat-banner-label {
		margin-top: 0;
		margin-bottom: 0.25rem;
	}
	.mat-banner p {
		margin: 0.25rem 0;
	}
</style>
