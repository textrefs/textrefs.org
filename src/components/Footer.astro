---
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>

<div class="license-footer">
	<p>
		Docs licensed <a href="https://creativecommons.org/licenses/by-sa/4.0/"
			>CC BY-SA 4.0</a
		>. Code <a href="https://www.gnu.org/licenses/agpl-3.0.html"
			>AGPL-3.0-or-later</a
		>. Data <a href="https://creativecommons.org/publicdomain/zero/1.0/"
			>CC0 1.0</a
		>.
	</p>
</div>

<style>
	.license-footer {
		margin-top: 1.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--sl-color-hairline-light);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
	.license-footer a {
		color: inherit;
		text-decoration: underline;
	}
	.license-footer a:hover {
		color: var(--sl-color-text-accent);
	}
</style>
